# Copia este archivo a .env.local y completa los valores.
# .env.local nunca se sube a git (ver .gitignore).

# --- Base de datos ---
# DATABASE_URL: la usa la app en runtime (rol app_tenant, con RLS forzado).
# DIRECT_URL: la usa `prisma migrate` (rol app_owner, con permisos de DDL/roles).
# ADMIN_DATABASE_URL: solo para el panel super-admin y jobs cross-tenant (rol app_admin, BYPASSRLS).
DATABASE_URL="postgresql://app_tenant:CAMBIAR@localhost:5433/reparacion_celulares?schema=public"
DIRECT_URL="postgresql://app_owner:CAMBIAR@localhost:5433/reparacion_celulares?schema=public"
ADMIN_DATABASE_URL="postgresql://app_admin:CAMBIAR@localhost:5433/reparacion_celulares?schema=public"

# --- Redis / colas (BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Almacenamiento de objetos (MinIO local / Cloudflare R2 en producción) ---
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID="CAMBIAR"
STORAGE_SECRET_ACCESS_KEY="CAMBIAR"
STORAGE_BUCKET_FOTOS="taller-fotos-equipos"
STORAGE_BUCKET_COMPROBANTES="taller-comprobantes"
STORAGE_FORCE_PATH_STYLE="true"

# --- Email local (Maildev). En producción: SMTP real o proveedor transaccional ---
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# --- Auth.js (NextAuth v5) ---
# Dos instancias separadas: login del tenant (dueño/técnico) y login del super-admin.
AUTH_SECRET="CAMBIAR"
AUTH_ADMIN_SECRET="CAMBIAR"
AUTH_TRUST_HOST="true"

# --- Cifrado (claves independientes, no reutilizar entre sí) ---
PIN_ENCRYPTION_KEY="CAMBIAR_32_BYTES_BASE64"
CREDENTIALS_ENCRYPTION_KEY="CAMBIAR_32_BYTES_BASE64"

# --- Plataforma / multi-tenant ---
# Dominio raíz sin subdominio, usado por el middleware para resolver el tenant.
# Local: localhost:3000 (con tenant1.localhost:3000, admin.localhost:3000, etc.)
# Producción: tuapp.com
PLATFORM_ROOT_DOMAIN="localhost:3000"
PLATFORM_NAME="Tu App de Reparaciones"
